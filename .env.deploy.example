# VPS deploy (көшіріп .env.deploy деп сақтаңыз; git-ке кірмейді)
RAQAT_VPS_HOST=5.75.162.140
RAQAT_VPS_USER=root
RAQAT_VPS_ROOT=/opt/raqat-ai
RAQAT_VPS_PUBLIC_URL=https://api.rahatomir.com
RAQAT_WEB_PUBLIC_URL=https://rahatomir.com
RAQAT_VPS_WEB_ROOT=/var/www/raqat-web/dist
# SSH (Windows: Git Bash kirill username path issue — PowerShell deploy қолданыңыз)
# RAQAT_VPS_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# Deploy Windows: powershell -File scripts/vps_deploy_web.ps1
# Deploy Linux/macOS/Git Bash: bash scripts/vps_deploy_web.sh
RAQAT_API_PORT=8000

# Bootstrap smoke login (VPS .env only — git-ке енгізбейді)
# Жергілікті provision: powershell -File scripts/provision_prod_smoke_auth.ps1
# RAQAT_AUTH_USERNAME=raqat-smoke
# RAQAT_AUTH_PASSWORD_BCRYPT=$2b$12$...
# RAQAT_SMOKE_AUTH_USERNAME=raqat-smoke
# RAQAT_SMOKE_AUTH_PASSWORD=...   # cron + dev preflight (VPS + .env.deploy)
