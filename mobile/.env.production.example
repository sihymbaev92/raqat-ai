# Production APK / AAB жинау алдында көшіріп атауыңыз: .env.production (gitке кірмейді).
# Gradle: npm run build:apk / npm run build:aab — load-raqat-expo-env.sh осы файлды соңғы болып жүктейді.
# EAS: eas secret:create — EXPO_PUBLIC_IMAM_AI_API_BASE (немесе EXPO_PUBLIC_RAQAT_API_BASE мұрагер)

# API: поддомен api.rahatomir.com (түбір сайт — Expo web UI).
EXPO_PUBLIC_IMAM_AI_API_BASE=https://api.rahatomir.com
EXPO_PUBLIC_RAQAT_API_BASE=https://api.rahatomir.com
EXPO_PUBLIC_RAQAT_WEB_URL=https://rahatomir.com
EXPO_PUBLIC_HALAL_DAMU_URL=https://halaldamu.kz/
# Native: api.rahatomir.com арқылы прокси (автоматты немесе USE_PROXY=1). Web — тікелей halaldamu.kz.
# EXPO_PUBLIC_HALAL_DAMU_USE_PROXY=1
# Тек тікелей halaldamu.kz (баяу ~8 с): EXPO_PUBLIC_HALAL_DAMU_DIRECT=1

# Қауіпсіздік: AI/content secret клиентке берілмейді.
# Толық AI үшін қолданбада кіру (JWT) керек.
# Қонақ AI: серверде RAQAT_AI_ALLOW_ANONYMOUS=1 (әдепкі).

# Web аналитика (Plausible) — export:web кезінде index.html-ге қосылады
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=rahatomir.com
