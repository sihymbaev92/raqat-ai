# Expo осы EXPO_PUBLIC_* айнымалыларын бандлер кезінде енгізеді.
# Түбір репо .env-те RAQAT_PLATFORM_API_BASE болса, load-raqat-expo-env.sh API base-ті көшіріруі мүмкін.
#
# Production: .env.production.example → .env.production (git ignore; құпиялар).
#
# Негізгі база URL — Imam Ai платформа API (ең жоғары басымдық):
# EXPO_PUBLIC_IMAM_AI_API_BASE=https://api.example.com
# Мұра атау (бұрынғы толтырма болса):
# EXPO_PUBLIC_RAQAT_API_BASE=https://api.example.com
#
# Жергілікті API (телефон құрылғысы ПК желімен бір желіде):
#   EXPO_PUBLIC_IMAM_AI_API_BASE=http://192.168.x.x:8787   (ПК-ның LAN IP)
# Android эмуляторда ПК localhost:
#   EXPO_PUBLIC_IMAM_AI_API_BASE=http://10.0.2.2:8787
# Контент оқу (серверде RAQAT_CONTENT_READ_SECRET болса): мобильді жинақта осымен бірдей мән:
# EXPO_PUBLIC_RAQAT_CONTENT_SECRET=...
# EXPO_PUBLIC_RAQAT_AI_KB_ONLY=1   — әдепкі қосулы (app.json extra.raqatAiKbOnly)
#
# Web Plausible (export:web / vps_deploy_web — index.html-ге скрипт):
# EXPO_PUBLIC_PLAUSIBLE_DOMAIN=rahatomir.com
#
# Google кіру (id_token): Google Cloud Console → OAuth 2.0 Client IDs (Web, iOS, Android).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=....apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=....apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=....apps.googleusercontent.com
# Серверде сәйкес RAQAT_GOOGLE_OAUTH_AUDIENCE (client id-лердің үтірмен тізімі) орнатылған болуы керек.
#
# Apple / iCloud кіру: тек iOS, Xcode/Apple Developer → Sign in with Apple қосу; серверде RAQAT_APPLE_OAUTH_AUDIENCE = bundle id.
#
# Ресми халал ақпарат (қолданба ішінде тек сыртқы сайтқа сілтейді):
# EXPO_PUBLIC_HALAL_DAMU_URL=https://halaldamu.kz/
# halaldamu JSON: native — api.rahatomir.com прокси (автоматты) немесе USE_PROXY=1
# Web: тікелей halaldamu.kz (CORS). IP http://5.75.x — 301/SSL; HTTPS домен қолданыңыз.
# EXPO_PUBLIC_HALAL_DAMU_USE_PROXY=1
# EXPO_PUBLIC_HALAL_DAMU_DIRECT=1
#
# Рақат / Imam AI ресми веб (чат экранында WebView — «ғалам» таңбасы; HTML көшірмесіз):
# EXPO_PUBLIC_RAQAT_WEB_URL=https://raqat.ai
#
# Hafs 604 Mushaf render backend (see mobile/assets/quran/README.txt):
# EXPO_PUBLIC_MUSHAF_PAGE_BACKEND=text-hafs|svg|webp|qcf4
# EXPO_PUBLIC_MUSHAF_PAGES_BASE=https://rahatomir.com/assets/quran
# EXPO_PUBLIC_QCF4_UPSTREAM_BASE=https://raw.githubusercontent.com/MohamadHajjRabee/quran-qcf4/main
# EXPO_PUBLIC_MUSHAF_SVG_UPSTREAM_BASE=https://raw.githubusercontent.com/mushafdatabase/MushafDatabase-Ligature-Based-SVG/main/pages
#
# Тәжуид MP3 + muftyat JPG (release APK stash; runtime CDN):
# EXPO_PUBLIC_TAJWEED_ASSETS_BASE=https://rahatomir.com/assets/tajweed
