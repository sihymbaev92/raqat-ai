{
  "name": "raqat-mobile",
  "version": "1.1.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 expo start --lan",
    "start:vps": "bash scripts/expo-vps.sh",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "android:emu": "powershell -ExecutionPolicy Bypass -File scripts/start-emulator.ps1",
    "android:live": "powershell -ExecutionPolicy Bypass -File scripts/run-android-live.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:lan": "expo start --web --port 8090 --host lan",
    "web:tunnel": "expo start --web --tunnel",
    "export:web": "bash scripts/export-web.sh",
    "export:web:win": "powershell -ExecutionPolicy Bypass -File scripts/export-web.ps1",
    "serve:web": "npx --yes serve dist -l 8090",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:full": "npm run lint && jest --ci",
    "test:auto-location": "jest src/services/__tests__/devicePrayerLocation.test.ts src/constants/__tests__/kzCities.test.ts --ci",
    "prebuild": "expo prebuild",
    "prebuild:ios": "powershell -ExecutionPolicy Bypass -File scripts/prebuild-ios.ps1",
    "prebuild:ios:unix": "bash scripts/prebuild-ios.sh",
    "generate:icon": "python scripts/generate-app-icon.py",
    "fetch:azan": "python scripts/fetch_prayer_azan_assets.py",
    "halal:seed": "python ../scripts/enrich_halal_products_seed.py",
    "halal:seed:off": "python ../scripts/expand_halal_products_seed_from_off.py",
    "official-books:sync": "python ../scripts/scrape_official_books.py",
    "halal:seed:build": "python ../scripts/build_halal_products_seed_json.py",
    "halal:additives:build": "python ../scripts/build_halal_additives_seed.py",
    "halal:seed:additives": "python ../scripts/build_halal_additives_seed.py",
    "build:apk": "node scripts/build-apk-node.cjs release",
    "qa:android:release": "powershell -ExecutionPolicy Bypass -File scripts/android-release-smoke.ps1",
    "qa:azan:locked": "powershell -ExecutionPolicy Bypass -File scripts/azan-locked-screen-qa.ps1 -GrantExactAlarm -WhitelistBattery",
    "qa:azan:oem": "powershell -ExecutionPolicy Bypass -File scripts/azan-oem-3day-qa.ps1",
    "build:ios": "powershell -ExecutionPolicy Bypass -File scripts/build-ios-eas.ps1",
    "build:aab": "node scripts/build-apk-node.cjs aab",
    "build:apk:debug": "node scripts/build-apk-node.cjs debug",
    "release:play:check": "powershell -ExecutionPolicy Bypass -File scripts/validate-play-release.ps1",
    "verify:cdn-assets": "powershell -ExecutionPolicy Bypass -File scripts/verify-cdn-assets.ps1",
    "release:minuses-preflight": "powershell -ExecutionPolicy Bypass -File scripts/release-minuses-preflight.ps1",
    "play:internal:handoff": "powershell -ExecutionPolicy Bypass -File scripts/play-internal-handoff.ps1",
    "size:assets": "node scripts/print-asset-size-report.cjs",
    "size:assets:budget": "node scripts/print-asset-size-report.cjs --max-total-mb 400",
    "eas:apk": "npx --yes eas-cli build --platform android --profile preview --non-interactive",
    "eas:ios": "npx --yes eas-cli build --platform ios --profile preview",
    "eas:ios:ipa": "npx --yes eas-cli build --platform ios --profile ios-device",
    "eas:ios:ipa:queue": "npx --yes eas-cli build --platform ios --profile ios-device --no-wait",
    "eas:ios:prod": "npx --yes eas-cli build --platform ios --profile production",
    "bundle:quran-data": "bash scripts/fetch-bundled-quran.sh",
    "bundle:i18n-offline": "node scripts/build-offline-auto-translations.mjs",
    "bundle:i18n-offline:all": "node scripts/build-offline-auto-translations.mjs --all",
    "bundle:i18n-apk": "node scripts/build-offline-auto-translations-apk.cjs",
    "bundle:i18n-spiritual": "node scripts/fill-spiritual-content-i18n.cjs && node scripts/build-offline-auto-translations-apk.cjs",
    "bundle:quran-translations": "node scripts/build-quran-translation-bundle.mjs",
    "export:quran-kk-bundle": "cd .. && .venv/bin/python scripts/export_quran_kk_bundled_json.py --db global_clean.db --out mobile/assets/bundled/quran-kk-from-db.json",
    "import:quran-erlan": "cd .. && bash scripts/run_erlan_quran_import.sh",
    "export:hadith-json": "cd .. && .venv/bin/python scripts/hadith_corpus_sync.py export --db global_clean.db --out mobile/assets/bundled/hadith-from-db.json --source-only",
    "export:hadith-json:full": "cd .. && .venv/bin/python scripts/hadith_corpus_sync.py export --db global_clean.db --out mobile/assets/bundled/hadith-from-db.json",
    "export:hadith-json:kk-only": "cd .. && .venv/bin/python scripts/hadith_corpus_sync.py export --db global_clean.db --out mobile/assets/bundled/hadith-from-db.json --only-with-kk",
    "export:scraped-hadith-muftyat": "echo scraped-hadith removed; exit 0",
    "extract:hadith-quotes": "cd .. && python scripts/extract_muftyat_hadith_quotes_mobile.py",
    "fill:hadith-en-ru": "cd .. && bash scripts/run_hadith_fawaz_en_ru.sh",
    "hadith:quality": "cd .. && python scripts\\hadith_quality_gate.py",
    "hadith:normalize": "cd .. && .\\.venv\\Scripts\\python.exe scripts\\normalize_hadith_kk_terms.py",
    "e2e:build:emu": "detox build -c android.emu.debug",
    "e2e:test:emu": "detox test -c android.emu.debug",
    "e2e:build:ci": "detox build -c android.att.ci",
    "e2e:test:ci": "detox test -c android.att.ci --loglevel verbose"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/lateef": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/scheherazade-new": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-speech": "14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "hijri-converter": "^1.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@bacons/apple-targets": "^4.0.7",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "detox": "^20.51.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.12",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  }
}
