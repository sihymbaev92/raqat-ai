<?xml version="1.0" encoding="utf-8"?>
<!-- 5 парыз + күн шығу: атау + уақыт -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

  <LinearLayout
      android:id="@+id/widget_strip_cell_fajr"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingVertical="1dp"
      android:paddingHorizontal="0dp">
    <TextView
        android:id="@+id/widget_strip_cell_fajr_lbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/widget_prayer_text"
        android:textSize="13dp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95" />
    <TextView
        android:id="@+id/widget_strip_cell_fajr_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_prayer_text"
        android:textSize="14dp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingTop="1dp" />
  </LinearLayout>

