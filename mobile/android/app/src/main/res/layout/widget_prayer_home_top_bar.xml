<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:minHeight="32dp"
    android:paddingBottom="1dp">

  <LinearLayout
      android:id="@+id/widget_home_weather_row"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="start|center_vertical"
      android:orientation="horizontal"
      android:gravity="center_vertical|start"
      android:minWidth="46dp">

    <TextView
        android:id="@+id/widget_home_weather_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:paddingEnd="2dp" />

    <TextView
        android:id="@+id/widget_home_weather_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_prayer_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false" />
  </LinearLayout>

  <FrameLayout
      android:id="@+id/widget_home_qibla_wrap"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center"
      android:background="@drawable/widget_qibla_chip_bg"
      android:padding="2dp"
      android:clickable="true"
      android:focusable="true">

    <ImageView
        android:id="@+id/widget_home_qibla_arrow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_qibla_a11y" />
  </FrameLayout>

  <LinearLayout
      android:id="@+id/widget_home_city_row"
      android:layout_width="104dp"
      android:layout_height="wrap_content"
      android:layout_gravity="end|center_vertical"
      android:orientation="horizontal"
      android:gravity="center_vertical|end"
      android:minWidth="46dp">

    <ImageView
        android:id="@+id/widget_home_city_pin"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/widget_ic_city_pin"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_city_a11y"
        android:layout_marginEnd="3dp" />

    <TextView
        android:id="@+id/widget_home_city"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_prayer_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="true" />
  </LinearLayout>
</FrameLayout>
