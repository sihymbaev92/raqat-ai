<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="2dp">

  <TextView
      android:id="@+id/widget_top_city"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="sans-serif-medium"
      android:textColor="@color/widget_prayer_next_time_bright"
      android:textSize="11sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false" />

  <TextView
      android:id="@+id/widget_next_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_marginEnd="4dp"
      android:gravity="center"
      android:textColor="@color/widget_prayer_accent"
      android:textSize="12sp"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:includeFontPadding="false" />

  <LinearLayout
      android:id="@+id/widget_top_weather_row"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical|end">

    <TextView
        android:id="@+id/widget_top_weather_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:paddingEnd="2dp" />

    <TextView
        android:id="@+id/widget_top_weather_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_prayer_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>
